# =============================================================
# Pretexta — Environment Configuration
# =============================================================
# `make build`, `make up` and `make dev` create .env from this file with
# random secrets (scripts/init-env.sh). NEVER commit .env to version control.
# =============================================================

# ---- Ports ----
FRONTEND_PORT=9443
BACKEND_PORT=9442
MONGO_PORT=47017

# ---- MongoDB ----
MONGO_USERNAME=soceng_admin
MONGO_PASSWORD=replace-with-random-value
DB_NAME=Pretexta

# ---- JWT Secret (long random string) ----
# If unset or left at the public default, the backend uses a random
# per-process secret and every restart logs all users out.
JWT_SECRET=change-this-secret-key-in-production

# ---- CORS Origins (comma-separated list of allowed frontend origins) ----
CORS_ORIGINS=http://localhost:9443,http://localhost:3000,http://localhost:80

# ---- Frontend → Backend URL (baked into React bundle at build time) ----
# For Docker: use the backend container port that's mapped to the host
# For local dev: http://localhost:8001
REACT_APP_BACKEND_URL=http://localhost:9442

# ---- Seed Admin User (created on first run if DB is empty) ----
# This user gets role=admin automatically. If the password is empty, the
# backend generates one and prints it once in its log.
SEED_ADMIN_USERNAME=soceng
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=Admin
